[Unit]
Description=Hydrogen Booster control service
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/hydrogen-booster
ExecStart=/usr/bin/hydrogen-booster -config /var/hydrogen-booster/config.json -listen :8080 -web /etc/hydrogen-booster/web -admin-password-file /var/hydrogen-booster/admin-password -dispense-log-file /var/hydrogen-booster/dispense-log.jsonl -valid-codes-file /var/hydrogen-booster/valid-codes.txt -history-db /var/hydrogen-booster/history.db
Restart=on-failure
RestartSec=5
User=egadmin

# Log output goes to the systemd journal, with faults and failures at
# priority "err" and rejected commands at "warning":
#   journalctl -u hydrogen-booster -f            follow live
#   journalctl -u hydrogen-booster -p warning    problems only
#   journalctl -u hydrogen-booster --since today
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydrogen-booster

# Raw SocketCAN access without running as root.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
