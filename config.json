{
  "massMeasurementEnabled": false,
  "nozzles": {
    "has700Bar": true,
    "sensorsEnabled": false
  },
  "pollPeriodMs": 100,
  "stage1": {
    "name": "Stage 1 (A/B)",
    "minStrokeTimeMs": 300,
    "maxStrokeTimeMs": 6000,
    "spikeDeltaBar": 15,
    "spikeWindowMs": 250,
    "reverseDelayMs": 500,
    "pressureFilterSamples": 1
  },
  "stage2": {
    "name": "Stage 2 (C/D)",
    "minStrokeTimeMs": 300,
    "maxStrokeTimeMs": 6000,
    "spikeDeltaBar": 15,
    "spikeWindowMs": 250,
    "reverseDelayMs": 500,
    "pressureFilterSamples": 1
  },
  "homing": {
    "durationMs": 8000
  },
  "pressureBlankTimeMs": 0,
  "outputPressureFilterSamples": 1,
  "safety": {
    "sensorLimits": [
      {"sensor": "Hyd1Pressure", "min": -1, "max": 25},
      {"sensor": "Hyd2Pressure", "min": -1, "max": 25},
      {"sensor": "TankPressure", "min": -1, "max": 300},
      {"sensor": "InterStagePressure", "min": -1, "max": 500},
      {"sensor": "OutputPressure", "min": -1, "max": 750},
      {"sensor": "HydOilTemp", "min": -30, "max": 85},
      {"sensor": "OutputTemp", "min": -30, "max": 85}
    ],
    "sensorMaxAgeMs": 2000
  },
  "tank": {
    "volumeLitres": 300,
    "nominalPressureBar": 35,
    "nominalTempC": 15
  },
  "vent": {
    "durationMs": 5000
  },
  "ventFan": {
    "offDelayMs": 10000
  },
  "coolingFan": {
    "setpointC": 50
  },
  "canModule": {
    "interface": "can0",
    "requestId": "0x101",
    "responseId": "0x1",
    "functionCode": 2,
    "pollPeriodMs": 200,
    "responseTimeoutMs": 300,
    "liveEnabled": false,
    "channels": [
      {"enabled": true, "assigned": "Hyd1Pressure", "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 65535, "calHighBar": 250},
      {"enabled": true, "assigned": "Hyd2Pressure", "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 65535, "calHighBar": 250},
      {"enabled": true, "assigned": "TankPressure", "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 65535, "calHighBar": 300},
      {"enabled": true, "assigned": "InterStagePressure", "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 65535, "calHighBar": 500},
      {"enabled": true, "assigned": "OutputPressure", "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 65535, "calHighBar": 750},
      {"enabled": false, "calLowRaw": 0, "calLowBar": 0, "calHighRaw": 0, "calHighBar": 0}
    ]
  },
  "tempModule": {
    "pollPeriodMs": 5000,
    "liveEnabled": false,
    "channels": [
      {"enabled": true, "assigned": "HydOilTemp", "deviceId": ""},
      {"enabled": true, "assigned": "OutputTemp", "deviceId": ""}
    ]
  },
  "relayModule": {
    "chip": "/dev/gpiochip16",
    "liveEnabled": false,
    "channels": [
      {"enabled": true, "assigned": "Valve1A(dir)", "port": 0},
      {"enabled": true, "assigned": "Valve1B(pulse)", "port": 1},
      {"enabled": true, "assigned": "Valve2A(dir)", "port": 2},
      {"enabled": true, "assigned": "Valve2B(pulse)", "port": 3},
      {"enabled": true, "assigned": "VentValve", "port": 4},
      {"enabled": true, "assigned": "Pump1", "port": 5},
      {"enabled": true, "assigned": "Pump2", "port": 6},
      {"enabled": true, "assigned": "VentFan", "port": 7},
      {"enabled": true, "assigned": "CoolingFan", "port": 8}
    ]
  },
  "digitalInputModule": {
    "chip": "/dev/gpiochip0",
    "liveEnabled": false,
    "channels": [
      {"enabled": true, "assigned": "HydraulicOilLevel", "port": 2},
      {"enabled": true, "assigned": "Motor1Powered", "port": 3},
      {"enabled": true, "assigned": "Motor2Powered", "port": 5},
      {"enabled": true, "assigned": "HydrogenDetected", "port": 6},
      {"enabled": true, "assigned": "Nozzle350InUse", "port": 12},
      {"enabled": true, "assigned": "Nozzle700InUse", "port": 13}
    ]
  },
  "flowModule": {
    "sensorType": "none",
    "port": "/dev/ttyUSB0",
    "baudRate": 9600,
    "useRs485": false,
    "address": 17,
    "unit": "kg/min",
    "pollPeriodMs": 500
  }
}
